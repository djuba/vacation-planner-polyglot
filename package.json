{
  "name": "ai-trip-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:check": "pnpm --filter @vp/domain-schema gen:check",
    "audit:prod": "pnpm audit --prod",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:functional": "vitest run --project functional --project functional-api && pnpm --filter @vp/web-nextjs test:functional",
    "test:contract": "node scripts/run-contract.ts",
    "test:contract:external": "node scripts/run-contract.ts --external",
    "test:image": "node scripts/test-image.ts",
    "record:cassettes": "node scripts/record-cassettes.ts",
    "invite:new": "node scripts/invite-code.ts",
    "eval": "node backends/api-nextjs/eval/run.ts",
    "test:journeys": "pnpm --filter @vp/journeys test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm gen:check && pnpm audit:prod && pnpm test:coverage && pnpm test:functional && pnpm test:contract",
    "verify:integrated": "node scripts/skip.mjs \"integrated gate (build all, start stack, journeys @smoke + @critical)\" WU-15",
    "verify:full": "node scripts/skip.mjs \"full gate (journeys @full and provider contracts against api-nextjs)\" WU-15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:"
  }
}
