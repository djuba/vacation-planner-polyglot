# Copy to .env.local at the repo root (git-ignored). Never put real secrets in this file.

# --- web (apps/web-nextjs) ---
# The only way the web client locates the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- api-nextjs (backends/api-nextjs) ---
# LLM_MODE and the MODEL_* variables are required; the server won't start without them.
# Origin allowed by CORS. Must be a bare origin, with no path or trailing slash.
WEB_ORIGIN=http://localhost:3000
# Anthropic API key. Needed only for LLM_MODE=live or LLM_MODE=record.
ANTHROPIC_API_KEY=
# live | record | replay | mock. Gated tests use mock or replay only.
LLM_MODE=replay
# Optional: where record/replay cassettes live. Defaults to <repo>/.llm-cassettes/api-nextjs.
LLM_CASSETTE_DIR=
# Model IDs: exact, no date suffix.
MODEL_FAST=claude-haiku-5-5
MODEL_REASONING=claude-sonnet-5-5
MODEL_CRITIC=claude-sonnet-5-5
# --- access gate (docs/features/access-gate.md) ---
# This machine is a developer's, not a hosted service. Without it the server applies the hosted
# rules: it refuses the committed codes below, record mode, ACCESS_GATE=off, and the memory store
# in live mode. Never set it on a hosted service (Cloud Run refuses it).
LOCAL_DEV=true
# Uncomment for a local demo with no code and no limits, in any LLM_MODE including live: the trip
# endpoints are then open and nothing caps spend but your Anthropic workspace limit. Needs
# LOCAL_DEV=true, and the tests always run with the gate on.
# ACCESS_GATE=off
# Comma-separated label:sha256(code) entries; make one with `pnpm invite:new <label>`. This one is
# the hash of `local-dev-invite`, which the web client sends in `pnpm dev`. It is committed, so
# anyone who knows the repository knows it: the server accepts it only with LOCAL_DEV=true, and
# warns about it in live or record mode.
INVITE_CODES=dev:ef0876a0698d41ecf40c3fab1c80b26e141b656ebb0162d1f53df242b96f3f26
# Revoked entries, moved here from INVITE_CODES: still refused, and logged as `revoked`.
REVOKED_INVITE_CODES=
# Only `memory` exists so far.
USAGE_STORE=memory
# Limits: unset means the defaults (60/3/5/30/300, see docs/features/access-gate.md). Local values must
# allow repeated `pnpm test:contract:external` runs, so they are generous here.
QUOTA_EXTRACT=10000
QUOTA_RECOMMEND=10000
QUOTA_PRESENT=10000
RATE_LIMIT_PER_HOUR=10000
RATE_LIMIT_GLOBAL_PER_DAY=10000

# --- tests ---
# Backend tested by `pnpm test:contract:external`. Plain `pnpm test:contract` ignores it and starts api-nextjs.
API_BASE_URL=http://localhost:4000
# The invite code `pnpm test:contract:external` sends: one the backend under test accepts.
CONTRACT_INVITE_CODE=local-dev-invite
